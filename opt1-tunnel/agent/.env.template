# ── On-Premise Agent Configuration ───────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.template .env

# ── Snowflake WebSocket endpoint ──────────────────────────────────────────────
# From: SHOW ENDPOINTS IN SERVICE SOVEREIGNTY_DEMO.OPT1_TUNNEL.TUNNEL_SERVICE;
# Copy the "websocket" endpoint URL (the public ingress hostname)
SNOWFLAKE_URL=wss://<your-endpoint>.snowflakecomputing.app

# ── Snowflake authentication ──────────────────────────────────────────────────
# Programmatic Access Token (PAT) — generate in Snowflake UI:
#   Admin → Security → Programmatic Access Tokens → + Token
SNOWFLAKE_PAT=<your-pat-token>

# Your Snowflake account identifier (e.g. myorg-myaccount)
SNOWFLAKE_ACCOUNT=<your-account>

# Optional: role to use when connecting (must have USAGE on the service)
SNOWFLAKE_ROLE=<your-role>

# Optional: full account URL (only needed for non-standard deployments)
# SNOWFLAKE_ACCOUNT_URL=https://<account>.snowflakecomputing.com
