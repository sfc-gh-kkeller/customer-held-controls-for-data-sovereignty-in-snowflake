# .streamlit/config.toml
# Streamlit Configuration for OIDC Authentication

[server]
port = 8501
enableCORS = false
enableXsrfProtection = true

# Authentication Configuration
[auth]
# Enable authentication providers
providers = ["oidc"]

# OIDC Configuration
[auth.oidc]
# Your OIDC provider's issuer URL
issuer = "https://your-oidc-provider.com"

# OAuth2/OIDC client credentials
clientId = "your-client-id"
clientSecret = "your-client-secret"

# Redirect URI (must match what's configured in your OIDC provider)
redirectUri = "https://your-app-domain.com/auth/callback"

# OIDC scopes to request
scopes = ["openid", "profile", "email"]

# Additional OIDC configuration (optional)
# responseType = "code"  # Default is "code"
# grantType = "authorization_code"  # Default is "authorization_code"

# ============================================================================
# PROVIDER-SPECIFIC EXAMPLES
# ============================================================================

# Example 1: Okta Configuration
# [auth.oidc]
# issuer = "https://your-domain.okta.com/oauth2/default"
# clientId = "0oa1a2b3c4d5e6f7g8h9"
# clientSecret = "your-okta-client-secret"
# redirectUri = "https://your-app.com/auth/callback"
# scopes = ["openid", "profile", "email", "groups"]

# Example 2: Auth0 Configuration
# [auth.oidc]
# issuer = "https://your-domain.auth0.com/"
# clientId = "your-auth0-client-id"
# clientSecret = "your-auth0-client-secret"
# redirectUri = "https://your-app.com/auth/callback"
# scopes = ["openid", "profile", "email"]

# Example 3: Azure AD Configuration
# [auth.oidc]
# issuer = "https://login.microsoftonline.com/your-tenant-id/v2.0"
# clientId = "your-azure-app-id"
# clientSecret = "your-azure-client-secret"
# redirectUri = "https://your-app.com/auth/callback"
# scopes = ["openid", "profile", "email"]

# Example 4: Google Configuration
# [auth.oidc]
# issuer = "https://accounts.google.com"
# clientId = "your-google-client-id.apps.googleusercontent.com"
# clientSecret = "your-google-client-secret"
# redirectUri = "https://your-app.com/auth/callback"
# scopes = ["openid", "profile", "email"]

# Example 5: Keycloak Configuration
# [auth.oidc]
# issuer = "https://your-keycloak.com/auth/realms/your-realm"
# clientId = "your-keycloak-client"
# clientSecret = "your-keycloak-secret"
# redirectUri = "https://your-app.com/auth/callback"
# scopes = ["openid", "profile", "email"]

# ============================================================================
# ENVIRONMENT VARIABLE ALTERNATIVE
# ============================================================================
# Instead of config.toml, you can use environment variables:
# 
# export STREAMLIT_AUTH_PROVIDERS="oidc"
# export STREAMLIT_AUTH_OIDC_ISSUER="https://your-oidc-provider.com"
# export STREAMLIT_AUTH_OIDC_CLIENT_ID="your-client-id"
# export STREAMLIT_AUTH_OIDC_CLIENT_SECRET="your-client-secret"
# export STREAMLIT_AUTH_OIDC_REDIRECT_URI="https://your-app.com/auth/callback"
# export STREAMLIT_AUTH_OIDC_SCOPES="openid,profile,email"

# ============================================================================
# DEVELOPMENT/LOCAL TESTING
# ============================================================================
# For local development, you can use environment variables like this:
# 
# # Local development with Okta
# export STREAMLIT_AUTH_PROVIDERS="oidc"
# export STREAMLIT_AUTH_OIDC_ISSUER="https://dev-12345.okta.com/oauth2/default"
# export STREAMLIT_AUTH_OIDC_CLIENT_ID="0oa1a2b3c4d5e6f7g8h9"
# export STREAMLIT_AUTH_OIDC_CLIENT_SECRET="your-secret"
# export STREAMLIT_AUTH_OIDC_REDIRECT_URI="http://localhost:8501/auth/callback"
# export STREAMLIT_AUTH_OIDC_SCOPES="openid,profile,email"
# 
# streamlit run app.py

# ============================================================================
# DEPLOYMENT CONSIDERATIONS
# ============================================================================
# 
# 1. HTTPS Required: Most OIDC providers require HTTPS for production
# 2. Redirect URI: Must be exactly what's configured in your OIDC provider
# 3. Client Secret: Keep secure, use environment variables in production
# 4. Scopes: Request only what you need (openid is required)
# 5. Provider Setup: Configure your app in the OIDC provider's console
#
# Common redirect URIs:
# - Local: http://localhost:8501/auth/callback
# - Production: https://your-app.example.com/auth/callback
# - Streamlit Cloud: https://your-app.streamlit.app/auth/callback
